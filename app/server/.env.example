# SiliconFlow OpenAI-compatible endpoint
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=replace-with-your-real-key
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Optional vision model (for photo recognition + explanation)
SILICONFLOW_VLM_MODEL=Qwen/Qwen3-VL-32B-Instruct

# Bocha web search (optional but recommended)
BOCHA_API_KEY=replace-with-your-bocha-key
BOCHA_BASE_URL=https://api.bochaai.com
BOCHA_SEARCH_COUNT=5
BOCHA_TIMEOUT_MS=12000
AI_ENABLE_WEB_SEARCH=true

# server
PORT=8787
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=45000
AI_HISTORY_MAX_ITEMS=10
AI_HISTORY_ITEM_MAX_CHARS=800
