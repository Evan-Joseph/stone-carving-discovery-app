# 前端默认请求 /api/ai/*。
# 所有密钥仅配置在服务端（Cloudflare Pages / Node server），不要写到前端环境变量。

# 可选：开发时启用 Service Worker 资源缓存（默认关闭，避免干扰 HMR）
# VITE_ENABLE_SW_IN_DEV=true

# 可选：前端开发代理目标（默认 http://127.0.0.1:8787）
# VITE_AI_PROXY_TARGET=http://127.0.0.1:8787

# 可选：前端直连后端 AI 地址（生产环境常用）
# 例如：https://your-service.example.com/api/ai
# VITE_AI_API_BASE=

# 服务端需配置（示例）：
# SILICONFLOW_API_KEY=...
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
# SILICONFLOW_VLM_MODEL=Qwen/Qwen3-VL-32B-Instruct
# BOCHA_API_KEY=...
